-- build_component.spl
-- Generic GDW component build workflow.
-- Reads a component graph.yaml, validates structure, generates each node
-- in topological order, verifies at node and edge level, caches results.
--
-- Analogous to build_concept_book.spl in the ConceptBook project, but
-- generates code artifacts instead of prose sections.
--
-- Usage:
--   spl3 run build_component.spl \
--     --component_graph components/backend/graph.yaml \
--     --tech_profile python_fastapi \
--     --output_dir backend/
--
-- Tech profiles defined in tools.py: python_fastapi, vue_typescript, go_gin, ...

CREATE FUNCTION write_node(node TEXT, spec TEXT, context TEXT, tech_profile TEXT)
RETURN TEXT
AS $$
You are an expert software engineer generating a code module.

{tech_profile}

Generate a self-contained implementation for: {node}
Specification: {spec}
Surrounding context (already-generated dependencies): {context}

Rules:
- Implement exactly what the spec requires; no speculative features
- No comments explaining what the code does; names must speak for themselves
- One comment only when the WHY is non-obvious (a constraint, a workaround, a subtle invariant)
- Follow the conventions in the tech profile above

Output only the implementation. No preamble, no explanation.
$$;

CREATE FUNCTION refine_node(code TEXT, feedback TEXT, tech_profile TEXT)
RETURN TEXT
AS $$
You are an expert software engineer. Revise the code below based on the feedback.
Keep all correct content; fix only what is flagged.

{tech_profile}

CODE:
{code}

FEEDBACK:
{feedback}

Output the revised code only. No preamble. No commentary.
$$;

CREATE FUNCTION repair_node(node TEXT, spec TEXT, context TEXT, test_failure TEXT, tech_profile TEXT)
RETURN TEXT
AS $$
You are an expert software engineer. A component test suite failed. Repair the module below.

{tech_profile}

Module to repair: {node}
Specification:
{spec}

Surrounding context (already-generated dependency files):
{context}

Test failure output:
{test_failure}

Common causes in this stack:
- Wrong HTTP verb (PATCH vs PUT, GET vs POST)
- Missing schema field (ToggleRequest, completed default, etc.)
- Re-defining something already declared in a dependency (e.g. get_db in main.py when it lives in database.py)
- Raising ValueError where the test expects HTTPException (or vice versa)
- Import path wrong (relative vs absolute, wrong module name)
- Missing Base.metadata.create_all(bind=engine) in main.py — causes OperationalError: no such table on every request;
  fix: import models, then call Base.metadata.create_all(bind=engine) before app = FastAPI()

CRITICAL: Output ONLY the corrected source code.
Do NOT use any tools. Do NOT call any functions. Do NOT read files. Do NOT explore the codebase.
No preamble, no explanation, no markdown fences. Just the raw corrected code.
$$;

-- ── Recipe-79 style test gate tools (TOOL_API returns native bool for ASSERT) ──

CREATE TOOL_API run_component_tests(output_dir TEXT, tech_profile TEXT)
RETURNS TEXT AS PYTHON $$
def run_component_tests(output_dir: str, tech_profile: str) -> str:
    import json, os, re, subprocess, sys
    # Absolute cwd: the gate must not depend on the workflow''s current directory.
    # A relative cwd here is what produced the earlier `exit 4` — pytest could not
    # find tests/ when the process cwd was not the repo root.
    workdir = os.path.abspath(output_dir)
    if tech_profile in ("python_fastapi", "python_library", "curriculum"):
        # sys.executable, not bare "python": always use the interpreter running the
        # workflow, so the gate can never fall back to a PATH python lacking the deps.
        cmd = [sys.executable, "-m", "pytest", "tests/", "--tb=short", "-q"]
        if not os.path.isdir(os.path.join(workdir, "tests")):
            return json.dumps({"passed": 0, "failed": 0, "returncode": 4, "collected": 0,
                               "no_tests": True,
                               "output": f"No tests/ directory under {workdir} — nothing to verify."})
    elif tech_profile == "vue_typescript":
        cmd = ["npm", "test"]
        # Mirror the python_fastapi check above: a missing package.json means npm
        # itself fails (ENOENT, exit 254) before running any test — the repair loop
        # would otherwise misread that as a broken component and "fix" code that
        # was never wrong. Scaffold absence, not a test failure.
        if not os.path.isfile(os.path.join(workdir, "package.json")):
            return json.dumps({"passed": 0, "failed": 0, "returncode": 254, "collected": 0,
                               "no_tests": True,
                               "output": f"No package.json under {workdir} — nothing to verify."})
    else:
        return json.dumps({"passed": 0, "failed": 0, "returncode": -1, "collected": 0,
                           "no_tests": True, "output": f"Unknown profile: {tech_profile}"})
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, cwd=workdir, timeout=120)
    except Exception as e:
        return json.dumps({"passed": 0, "failed": 0, "returncode": -1, "collected": 0,
                           "no_tests": False, "output": f"Test run errored: {e}"})
    out = proc.stdout + proc.stderr
    passed = failed = 0
    for line in out.splitlines():
        if m := re.search(r"(\d+) passed", line):
            passed = int(m.group(1))
        if m := re.search(r"(\d+) failed", line):
            failed = int(m.group(1))
    collected = passed + failed
    # pytest exit 4 = usage error (path not found); exit 5 = no tests collected.
    # Either way the suite is absent — distinct from a real failure the repair loop can fix.
    # exit 4 = usage error (path not found) or conftest import failure; exit 5 = no tests collected.
    # ImportError/ModuleNotFoundError in the output means the suite *exists* but can''t load —
    # treat as a real failure so the repair loop fires rather than halting with "no tests found".
    import_error = any(tok in out for tok in ("ImportError", "ModuleNotFoundError"))
    no_tests = collected == 0 and proc.returncode in (4, 5) and not import_error
    return json.dumps({"passed": passed, "failed": failed, "returncode": proc.returncode,
                       "collected": collected, "no_tests": no_tests, "output": out[-3000:]})
$$;

CREATE TOOL_API all_tests_passed(test_json TEXT)
RETURNS TEXT AS PYTHON $$
def all_tests_passed(test_json: str) -> bool:
    import json
    try:
        d = json.loads(test_json)
        return (d.get("returncode", 1) == 0
                and d.get("failed", 1) == 0
                and d.get("passed", 0) > 0)
    except Exception:
        return False
$$;

CREATE TOOL_API get_test_status(test_json TEXT)
RETURNS TEXT AS PYTHON $$
def get_test_status(test_json: str) -> str:
    import json
    try:
        d = json.loads(test_json)
        if d.get("no_tests"):
            return "no_tests"
        if (d.get("returncode", 1) == 0
                and d.get("failed", 1) == 0
                and d.get("passed", 0) > 0):
            return "passed"
        return "failed"
    except Exception:
        return "failed"
$$;

CREATE TOOL_API get_test_output(test_json TEXT)
RETURNS TEXT AS PYTHON $$
def get_test_output(test_json: str) -> str:
    import json
    try:
        return json.loads(test_json).get("output", test_json)
    except Exception:
        return test_json
$$;

CREATE TOOL_API get_test_summary(test_json TEXT)
RETURNS TEXT AS PYTHON $$
def get_test_summary(test_json: str) -> str:
    import json
    try:
        d = json.loads(test_json)
        return (f"{d.get('passed', 0)} passed, {d.get('failed', 0)} failed "
                f"(exit {d.get('returncode', 1)})")
    except Exception:
        return "unknown"
$$;

CREATE FUNCTION write_node_spec(node TEXT, composed_of TEXT, tech_profile TEXT)
RETURN TEXT
AS $$
You are a software architect writing a node specification.

{tech_profile}

Write a precise specification for: {node}
Dependencies (composed_of / needs): {composed_of}

The spec must include:
1. Interface: function/class signatures, API surface, data schemas
2. Contract: preconditions, postconditions, invariants, error cases
3. Verification: how to confirm this node works in isolation (node-level)
4. Edge verification: how to confirm its contracts with each dependency (edge-level)

Output only the specification. No preamble.
$$;

-- ── Main workflow ─────────────────────────────────────────────────────────────

WORKFLOW build_component
    INPUT:
        @component_graph TEXT DEFAULT 'components/backend/graph.yaml',
        @tech_profile TEXT DEFAULT 'python_fastapi',
        @output_dir TEXT DEFAULT 'backend/',
        @log_dir TEXT DEFAULT 'logs/spl',
        @use_cache TEXT DEFAULT 'true',
        @max_test_attempts INTEGER DEFAULT 3
    OUTPUT:
        @manifest TEXT
DO
    CALL now_float() INTO @t_start
    CALL now_iso() INTO @_ts
    CALL sanitize_ts(@_ts) INTO @_ts_safe
    CALL make_log_path(@log_dir, @_ts_safe) INTO @log_file
    CALL write_file(@log_file, f"# Component Build\n\ngraph: {@component_graph}\nprofile: {@tech_profile}\nstarted: {@_ts}\n\n", "w") INTO @_

    -- 1. Load and validate graph: acyclicity, reducibility to primitives
    CALL setup_graph(@component_graph) INTO @_
    CALL get_tech_profile(@tech_profile) INTO @profile_guide
    CALL order_length(@component_graph) INTO @order_len
    CALL order_bullets(@component_graph) INTO @_order_bullets

    -- Declared call-contract self-consistency (consumer_requires vs
    -- provider_guarantees in function.calls). Soft warning only — does NOT
    -- inspect generated code, so it cannot catch code-vs-contract drift
    -- (e.g. the toggleTodo PATCH-vs-PUT bug in docs/DEV/BUILD/README.md
    -- §7.4.1); it only catches the yaml's own two declared sides
    -- disagreeing with each other. See contract_warnings()'s docstring.
    CALL contract_warnings(@component_graph) INTO @_contract_warnings
    EVALUATE @_contract_warnings
        WHEN = "" THEN
            LOGGING "No declared call-contract mismatches" LEVEL INFO
        ELSE
            LOGGING f"Call-contract warnings:\n{@_contract_warnings}" LEVEL WARN
            CALL write_file(@log_file, f"## Call-contract warnings\n\n{@_contract_warnings}\n\n", "a") INTO @_
    END

    LOGGING f"Component: {@component_graph}  Profile: {@tech_profile}" LEVEL INFO
    LOGGING f"Building {@order_len} nodes in topological order" LEVEL INFO
    CALL write_file(@log_file, f"## Build order ({@order_len} nodes)\n\n{@_order_bullets}\n\n", "a") INTO @_

    -- 2. Generate and verify one node at a time in dependency order
    @manifest := ""
    @_i := 0

    WHILE @_i < @order_len DO
        CALL order_item(@component_graph, @_i) INTO @node
        CALL now_float() INTO @t_node_start
        LOGGING f"Node {@_i}: {@node}" LEVEL INFO

        -- Cache check: skip regeneration if node already verified. Keyed on
        -- (node, spec, tech_profile) so an edited spec correctly misses, and
        -- disk-backed under @output_dir/.spl_cache so it survives across
        -- separate `spl3 run` invocations, not just within one process.
        CALL node_spec(@node, @component_graph) INTO @spec
        CALL node_context(@node, @component_graph, @output_dir) INTO @context
        CALL cache_get(@node, @spec, @tech_profile, @output_dir, @component_graph) INTO @code
        CALL apply_use_cache(@code, @use_cache) INTO @code

        EVALUATE @code
            WHEN = "miss" THEN
                LOGGING f"cache MISS for {@node} — generating" LEVEL INFO

                -- Generate spec if not declared in graph.yaml
                CALL has_spec(@node, @component_graph) INTO @_has_spec
                EVALUATE @_has_spec
                    WHEN = "no" THEN
                        CALL node_composed_of(@node, @component_graph) INTO @_deps
                        GENERATE write_node_spec(@node, @_deps, @profile_guide) INTO @spec
                        CALL save_spec(@node, @spec, @component_graph) INTO @_
                    ELSE
                        LOGGING f"Using declared spec for {@node}" LEVEL INFO
                END

                -- Generate implementation
                GENERATE write_node(@node, @spec, @context, @profile_guide) INTO @code

                -- Node-level verification
                CALL verify_node(@node, @code, @spec, @component_graph, @tech_profile) INTO @check
                EVALUATE @check
                    WHEN contains("fail") THEN
                        LOGGING f"Node verification failed for {@node} — refining" LEVEL WARN
                        GENERATE refine_node(@code, @check, @profile_guide) INTO @code
                    ELSE
                        LOGGING f"Node verified: {@node}" LEVEL INFO
                END

                -- Edge-level verification
                CALL verify_edges(@node, @code, @component_graph, @tech_profile) INTO @edge_check
                EVALUATE @edge_check
                    WHEN contains("fail") THEN
                        LOGGING f"Edge verification failed for {@node} — refining" LEVEL WARN
                        GENERATE refine_node(@code, @edge_check, @profile_guide) INTO @code
                    ELSE
                        LOGGING f"Edges verified: {@node}" LEVEL INFO
                END

                CALL cache_put(@node, @code, @spec, @tech_profile, @output_dir) INTO @cache_key
                LOGGING f"Cached {@node} → {@cache_key}" LEVEL INFO
            ELSE
                LOGGING f"cache HIT for {@node} — reusing verified code from {@output_dir}/.spl_cache" LEVEL INFO
        END

        -- Write node to output directory
        CALL write_node_file(@node, @code, @component_graph, @output_dir, @tech_profile) INTO @_file_path
        LOGGING f"Written: {@_file_path}" LEVEL INFO

        CALL time_elapsed(@t_node_start) INTO @node_elapsed
        @manifest := @manifest + f"\n{@node}: {@_file_path} ({@node_elapsed}s)"
        @_i := @_i + 1
    END

    CALL time_elapsed(@t_start) INTO @total_elapsed
    LOGGING f"Component build complete: {@order_len} nodes in {@total_elapsed}s" LEVEL INFO
    CALL write_file(@log_file, f"## Complete\n\ntotal: {@total_elapsed}s\n\nManifest:\n{@manifest}\n", "a") INTO @_

    -- 3. Component-level test gate (recipe 79 pattern)
    -- Tests are deterministic; the ASSERT below is a formal correctness certificate.
    -- If tests fail, identify the capstone node, repair it with the failure output,
    -- and re-run — up to @max_test_attempts attempts before the ASSERT hard-fails the workflow.
    LOGGING "Stage 3: component test suite" LEVEL INFO
    @_test_tries := 0
    @_test_max   := @max_test_attempts

    WHILE @_test_tries < @_test_max DO
        CALL run_component_tests(@output_dir, @tech_profile) INTO @test_result
        CALL get_test_status(@test_result) INTO @_test_status
        CALL get_test_summary(@test_result) INTO @_test_summary
        @_test_tries := @_test_tries + 1
        LOGGING f"Test attempt {@_test_tries}: {@_test_summary}" LEVEL INFO

        EVALUATE @_test_status
            WHEN = "passed" THEN
                @_test_tries := @_test_max
            WHEN = "no_tests" THEN
                LOGGING "No test suite found for this component — cannot verify. Halting repair loop; the ASSERT below will fail the build." LEVEL ERROR
                @_test_tries := @_test_max
            ELSE
                LOGGING f"Tests failed — identifying broken node" LEVEL WARN
                CALL get_test_output(@test_result) INTO @_test_failure
                CALL identify_broken_node(@_test_failure, @component_graph) INTO @_capstone
                LOGGING f"Repairing node: {@_capstone}" LEVEL WARN
                CALL node_spec(@_capstone, @component_graph) INTO @_cap_spec
                CALL node_context(@_capstone, @component_graph, @output_dir) INTO @_cap_context
                GENERATE repair_node(@_capstone, @_cap_spec, @_cap_context, @_test_failure, @profile_guide) INTO @_repaired
                CALL write_node_file(@_capstone, @_repaired, @component_graph, @output_dir, @tech_profile) INTO @_
        END
    END

    CALL write_file(@log_file, f"## Tests\n\n{@_test_summary}\n", "a") INTO @_
    ASSERT all_tests_passed(@test_result)
    LOGGING f"ASSERT passed — {@_test_summary}" LEVEL INFO

    RETURN @manifest
END
